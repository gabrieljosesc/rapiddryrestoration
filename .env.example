# RapidDry Restoration — copy to .env.local and fill in.
# Every integration below is optional: without it the site runs in demo mode
# (forms accept submissions and log them, nothing is persisted or emailed).

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_or_anon_key
# Server-only. Used by /api/emergency to write leads. Bypasses RLS — never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email alerts (Resend, https://resend.com) ---
RESEND_API_KEY=
# After verifying the domain: "RapidDry Restoration <alerts@yourdomain.ca>"
EMAIL_FROM=
OWNER_ALERT_EMAIL=owner@example.com

# --- Google Analytics 4 / Google Tag Manager / Google Ads ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Conversion labels: one for "emergency form submitted", one for "call button clicked".
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
NEXT_PUBLIC_GOOGLE_ADS_CALL_LABEL=

# --- Call tracking ---
# If the ads team issues a call-tracking number, set it here and the site will
# display it instead of the main line (name/address/phone on the site must
# still match the Google Business Profile — use a GBP-linked tracking number).
NEXT_PUBLIC_TRACKING_PHONE=

# --- IndexNow (Bing / ChatGPT search pickup) ---
# Any 8-128 char hex/alphanumeric key. Served at /indexnow.txt; POST /api/indexnow to submit the sitemap.
INDEXNOW_KEY=
